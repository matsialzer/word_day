# --- Telegram ---
BOT_TOKEN=123456:replace-me
ADMIN_ID=123456789

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://worddays:worddays@localhost:5432/worddays

# --- Redis (необязательно; пусто = FSM в памяти) ---
REDIS_URL=

# --- Прочее ---
LOG_LEVEL=INFO
AUDIO_DIR=data/audio
IMAGE_DIR=data/images
# Ключ Pixabay (бесплатно: pixabay.com/api/docs) - для scripts/fetch_photos.py
PIXABAY_API_KEY=
# Слов в день по умолчанию. Дальше значение меняется в боте: /admin (хранится в БД)
WORDS_PER_DAY=10

# --- Бонусы (сум). Бюджеты и BONUS_TOP_N - значения по умолчанию, в боте меняются через /admin ---
BONUS_AMOUNT_MIN=3000
BONUS_AMOUNT_MAX=5000
BONUS_WEEKLY_BUDGET=50000
BONUS_MONTHLY_BUDGET=200000
BONUS_TOP_N=3

# --- Веб-панель администратора (python -m worddays.web) ---
# Пароль входа. Без него панель не запустится. Задайте длинный случайный.
WEB_ADMIN_PASSWORD=
# Секрет подписи сессий (например: python -c "import secrets; print(secrets.token_hex(32))")
WEB_SECRET_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=8000
# true, если панель открыта по HTTPS
WEB_COOKIE_SECURE=false
